# Reddit asks for a descriptive, contact-able User-Agent. Be polite — bare
# "node-fetch" UAs get rate-limited harder. Format suggestion:
#   <project>/<version> (by /u/<your_reddit_username>)
REDDIT_USER_AGENT="freqsource/0.1 (by /u/your_username)"

# SQLite file path (relative to project root). Created on first init-db.
DATABASE_PATH="data/freqsource.db"
